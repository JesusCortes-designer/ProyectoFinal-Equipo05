meta {
  name: Actualizar viaje
  type: http
  seq: 6
}

put {
  url: {{url}}/api/viajes/{{viajeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "fechaSalida": "2027-03-10T09:00:00",
    "fechaLlegada": "2027-03-10T16:00:00",
    "estado": "PROGRAMADO",
    "autobusId": "{{autobusId}}",
    "choferId": "{{choferId}}",
    "rutaId": "{{rutaId}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
