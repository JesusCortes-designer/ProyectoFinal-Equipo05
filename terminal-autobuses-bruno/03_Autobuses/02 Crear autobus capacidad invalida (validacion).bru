meta {
  name: Crear autobus capacidad invalida (validacion)
  type: http
  seq: 2
}

post {
  url: {{url}}/api/autobuses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "placa": "X",
    "modelo": "X",
    "capacidad": 5,
    "estado": "DISPONIBLE",
    "terminalId": "{{terminalId}}"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("responde 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
