meta {
  name: Listar terminales (paginado)
  type: http
  seq: 5
}

get {
  url: {{url}}/api/terminales?buscar=&pagina=1&tamano=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

assert {
  res.status: eq 200
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("trae paginacion", function() {
    expect(res.body).to.have.property("totalPaginas");
  });
}
