meta {
  name: Crear terminal temporal
  type: http
  seq: 8
}

post {
  url: {{url}}/api/terminales
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombre": "Temporal {{sufijo}}",
    "ciudad": "Temp",
    "direccion": "Temp 1"
  }
}

script:post-response {
  bru.setVar("terminalTempId", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("responde 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
