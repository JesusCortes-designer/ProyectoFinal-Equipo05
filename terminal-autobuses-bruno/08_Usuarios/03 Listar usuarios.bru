meta {
  name: Listar usuarios
  type: http
  seq: 3
}

get {
  url: {{url}}/api/usuarios?buscar=&rol=&pagina=1&tamano=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

assert {
  res.status: eq 200
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
