meta {
  name: Login contrasena incorrecta
  type: http
  seq: 4
}

post {
  url: {{url}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{adminCorreo}}",
    "contrasena": "Incorrecta1!"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("responde 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
