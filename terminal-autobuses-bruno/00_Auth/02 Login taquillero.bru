meta {
  name: Login taquillero
  type: http
  seq: 2
}

post {
  url: {{url}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{taquillaCorreo}}",
    "contrasena": "{{taquillaPass}}"
  }
}

script:post-response {
  bru.setVar("tokenTaquilla", res.body.token);
}

assert {
  res.status: eq 200
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
